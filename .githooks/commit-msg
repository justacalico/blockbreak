#!/bin/sh
# Safety net: prefix non-conventional subjects with "misc:" so cog check passes.
msg_file="$1"
subject="$(head -n1 "$msg_file")"
if echo "$subject" | grep -qE '^(feat|fix|chore|ci|docs|refactor|style|test|perf|revert|build|misc)(\(.+\))?!?: .+'; then
  exit 0
fi
sed -i "1s/^/misc: /" "$msg_file"
